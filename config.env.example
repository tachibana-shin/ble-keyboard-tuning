# Copy this file to config.env and fill in your local values.
# config.env is gitignored. Never commit real MACs, link keys, or btmon logs.

# HCI adapter index: hci0 -> 0
HCI_INDEX=0

# Host adapter MAC and keyboard MAC. Case is normalized by the scripts.
ADAPTER_MAC="AA:BB:CC:DD:EE:FF"
KEYBOARD_MAC="11:22:33:44:55:66"

# Runtime LE parameters used by apply-active-le.sh.
# Interval values are in 1.25 ms units; supervision timeout is in 10 ms units.
MIN_INTERVAL=12
MAX_INTERVAL=12
LATENCY=0
SUPERVISION_TIMEOUT=300

# Optional connection handle for apply-active-le.sh (decimal or 0x-prefixed).
# The default in the script is 0x0020; override if the handle changed.
# HANDLE=0x0020
